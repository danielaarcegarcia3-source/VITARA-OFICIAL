rules_version = '2';
// VITARA usa Node + JSON privado, no Firestore. Fallar cerrado en un despliegue accidental.
// Cualquier futura integración cloud necesita diseño y pruebas de permisos propios.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
